NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Keep provider credentials separate. Set MODEL_PROVIDER=openai for the temporary fallback.
MODEL_PROVIDER=meta
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Faster Meta model for the live camera glance only; memory keeps META_MODEL (see docs/AI_TECHNICAL_STORY.md).
META_VISION_MODEL=muse-spark-1.2
META_API_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Completion cap for Meta and OpenAI (1-6000; includes reasoning tokens)
MODEL_MAX_COMPLETION_TOKENS=6000
# Meta pilot: minimal improved median in a small paired image test; validate actual props.
# minimal | low | medium | high. Use low if real-photo recognition regresses.
VISION_REASONING_EFFORT=minimal
# Keep the visual inventory short; text memory preparation retains the larger cap above.
VISION_MAX_COMPLETION_TOKENS=1536
# Server normalizes uploads and camera captures alike. 512–1280; benchmark readable labels before lowering.
VISION_MAX_IMAGE_EDGE=1024
DECISION_REASONING_EFFORT=low
# Relationship memory preparation effort (low | medium | high). Low is fast and was reliable in live runs.
MEMORY_REASONING_EFFORT=low
DEMO_MODE=false
DEMO_OWNER_ID=
# Used only by npm run demo:setup and npm run live:check (never sent to the browser)
DEMO_SCANNER_EMAIL=
DEMO_SCANNER_PASSWORD=
DEMO_SCANNER_NAME=Alex
DEMO_RECIPIENT_EMAIL=
DEMO_RECIPIENT_PASSWORD=
DEMO_RECIPIENT_NAME=Maya
DEMO_RECIPIENT_PERSON=maya
# Advice contacts for the shopping continuation; without an advisor account they map to the recipient phone
DEMO_ADVICE_PERSONS=noah
DEMO_ADVISOR_EMAIL=
DEMO_ADVISOR_PASSWORD=
DEMO_ADVISOR_NAME=Noah
APP_ORIGIN=http://localhost:3000
COMMERCE_ENABLED=false
# Live shopping discovery from the native-sms-only branch (server-only).
# Configure either provider to show live prices; otherwise ingredient search links remain available.
SEARCHAPI_API_KEY=
SERPAPI_API_KEY=
BESTBUY_API_KEY=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Optional AR generation overrides. Nearby uses Meta Responses with the web_search tool.
AR_ACTIVITY_MODEL=muse-spark-1.1
AR_NEARBY_MODEL=muse-spark-1.1
# Stripe TEST mode only (sk_test_…); live keys are refused. Webhook: https://<app>/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signs unsaved hover previews (at least 32 random characters, e.g. `openssl rand -hex 32`). Optional but recommended.
PREVIEW_SIGNING_SECRET=
# Optional nearby sharing; enable only after presence migration and phone testing.
NEXT_PUBLIC_ENABLE_PROXIMITY=false
# Experimental glasses send/reply flow. Requires migration and physical rehearsal; leave off for the phone demo.
GLASSES_MESSAGING_ENABLED=false
# Native SMS only: server-only nested map {"owner-uuid":{"person-id":"+E164"}}.
SMS_RECIPIENTS_JSON={}
